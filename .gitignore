# =============================================================================
# Gitignore for IBM Power Porting Triage Agent (Python + React / Node.js)
# =============================================================================

# -----------------------------------------------------------------------------
# Sensitive Data, Secrets & Credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
service_account*.json
service-account*.json
secrets.json
secrets.yaml
secrets.yml
local.settings.json
auth.json
tokens.json
*.token
*.secret

# -----------------------------------------------------------------------------
# Downloaded Dependencies & Package Directories
# -----------------------------------------------------------------------------
# Node.js / Frontend dependencies
node_modules/
**/node_modules/
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python Virtual Environments
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
env.bak/
venv.bak/
site-packages/

# Python packaging & wheels
*.whl
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
pip-log.txt

# -----------------------------------------------------------------------------
# Build Outputs & Distribution
# -----------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
.cache/

# -----------------------------------------------------------------------------
# Python Bytecode, Caching & Testing Artifacts
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Temporary Files, Cloned Repos & Scratch Caches
# -----------------------------------------------------------------------------
scratch/
tmp/
temp/
downloads/
.repo_cache/
cloned_repos/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Logs & Local Databases
# -----------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db

# -----------------------------------------------------------------------------
# Operating System & IDE Specific Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
